{
  "name": "service-desk-management",
  "version": "1.0.0",
  "description": "A service desk management app written in MEVN stack",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm run install-client && cd client && npm run build && tsc",
    "install-client": "cd client && npm install",
    "heroku-postbuild": "npm run install-client && npm run build",
    "start": "node dist/server.js",
    "server": "tsx server.ts",
    "dev": "concurrently -n 'server,client' -c 'red,green' \"nodemon\" \"npm run client\"",
    "client": "cd client && npm run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Apfirebolt/service-desk-management-application-in-express-and-vue.git"
  },
  "keywords": [
    "Service",
    "Desk",
    "MEVN"
  ],
  "author": "Apfirebolt",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Apfirebolt/service-desk-management-application-in-express-and-vue/issues"
  },
  "homepage": "https://github.com/Apfirebolt/service-desk-management-application-in-express-and-vue#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-history-api-fallback": "^2.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
